<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creative Web Design</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <!-- Header với nền ảnh và hiệu ứng blur -->
    <header class="header">
        <div class="header-content">
            <h1>Creative Web Design</h1>
            <p>Thiết kế website chuyên nghiệp - Hiện đại - Ấn tượng</p>
            <a href="#services" class="btn">Khám phá ngay</a>
        </div>
    </header>

    <!-- Thanh điều hướng -->
    <nav class="navbar">
        <ul>
            <li><a href="#">Trang chủ</a></li>
            <li><a href="#services">Dịch vụ</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Liên hệ</a></li>
        </ul>
    </nav>

    <!-- Content Section với Card Layout -->
    <section class="content" id="services">
        <h2>Dịch vụ của chúng tôi</h2>
        <div class="card-container">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&auto=format&fit=crop&q=80" alt="Dịch vụ 1">
                <h3>Thiết kế Website</h3>
                <p>&bull; Chúng tôi tạo ra những trang web chuyên nghiệp, thân thiện với người dùng.</p>
            </div>
            <div class="card">
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&auto=format&fit=crop&q=80" alt="Dịch vụ 2">
                <h3>SEO & Marketing</h3>
                <p>&bull; Giúp website của bạn đạt thứ hạng cao trên công cụ tìm kiếm.</p>
            </div>
            <div class="card">
                <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=600&auto=format&fit=crop&q=80" alt="Dịch vụ 3">
                <h3>Hỗ trợ 24/7</h3>
                <p>&bull; Đội ngũ hỗ trợ luôn sẵn sàng giúp bạn giải quyết mọi vấn đề.</p>
            </div>
        </div>
    </section>

    <!-- Footer với 2 cột (Bản quyền + Mạng xã hội) -->
    <footer class="footer">
        <div class="footer-left">
            <p>&bull; &copy; 2025 Creative Web. All rights reserved.</p>
        </div>
        <div class="footer-right">
            <p>&bull; Theo dõi chúng tôi:</p>
            <p>&bull; Facebook | Twitter | LinkedIn</p>
        </div>
    </footer>

</body>
</html>
